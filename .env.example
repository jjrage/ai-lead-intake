# Copy to .env and fill in. .env is gitignored; never commit real keys.

# --- docker compose -----------------------------------------------------------
# Pin the exact n8n version (n8n 3.0 is due in October 2026 with breaking changes).
N8N_VERSION=2.40.7
TIMEZONE=America/Denver

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=n8n
POSTGRES_NON_ROOT_USER=n8n
POSTGRES_NON_ROOT_PASSWORD=change-me-too

# Encrypts the credentials n8n stores. Generate once and keep it: losing it locks you out of them.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"
N8N_ENCRYPTION_KEY=
# Shared secret between n8n and its task runner container. Any random string.
RUNNERS_AUTH_TOKEN=

# --- API keys ------------------------------------------------------------------
# Used by the eval scripts and turned into n8n credentials by scripts/setup-credentials.mjs.
# Gemini API key (aistudio.google.com); the workflow's default model.
GEMINI_API_KEY=
# Claude API key (console.anthropic.com). Use a separate key with a spend limit.
ANTHROPIC_API_KEY=

# --- n8n credentials (imported once by: node scripts/setup-credentials.mjs) ----------
# HubSpot: Development > Keys > Service keys (or a legacy private app). Scopes:
# crm.objects.contacts.read/write, crm.objects.deals.read/write.
HUBSPOT_SERVICE_KEY=
# Slack app bot token (xoxb-...), scopes chat:write and chat:write.public.
SLACK_BOT_TOKEN=
# Google Cloud OAuth client (Web application) for the demo Gmail inbox.
# Redirect URI: http://localhost:5678/rest/oauth2-credential/callback
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
