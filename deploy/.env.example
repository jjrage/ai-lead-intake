# Public server settings. Copy to deploy/.env on the server (scripts/vps.sh env creates it
# with fresh secrets). .env is gitignored; never commit real keys.

# Hostname the webhooks are served on. Without a domain, sslip.io maps the server's IP to a name
# Caddy can get a certificate for: 203.0.113.7 -> 203-0-113-7.sslip.io
PUBLIC_HOST=
N8N_VERSION=2.44.4
CADDY_VERSION=2.11.7
TIMEZONE=America/Phoenix
# How long n8n keeps execution data (hours). They contain message text.
EXECUTIONS_MAX_AGE_HOURS=168

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=n8n
POSTGRES_NON_ROOT_USER=n8n
POSTGRES_NON_ROOT_PASSWORD=
# Encrypts the credentials n8n stores. Generate once and keep it.
N8N_ENCRYPTION_KEY=
RUNNERS_AUTH_TOKEN=

# --- API keys (turned into n8n credentials by: node scripts/setup-credentials.mjs --remote <ssh host>) ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
HUBSPOT_SERVICE_KEY=
SLACK_BOT_TOKEN=
# Slack app > Basic Information > Signing Secret: verifies events from Slack (team replies in threads).
SLACK_SIGNING_SECRET=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
# WhatsApp Cloud API. Business settings > System users > Generate token (never expires; business_management,
# whatsapp_business_management, whatsapp_business_messaging). The app secret checks that webhooks come from Meta.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WABA_ID=
WHATSAPP_PHONE_NUMBER_ID=
META_APP_ID=
META_APP_SECRET=
# Messenger and Instagram: the Facebook Page and the Instagram professional account linked to it.
# On your computer only: META_SYSTEM_TOKEN, a system user token with the Page and the Instagram account
# assigned (never expires; pages_messaging, pages_manage_metadata, pages_show_list, pages_read_engagement,
# instagram_basic, instagram_manage_messages). `node scripts/meta-setup.mjs` turns it into META_PAGE_TOKEN.
META_SYSTEM_TOKEN=
META_PAGE_TOKEN=
# GoHighLevel (when the profile's crm.providers lists it): a Private Integration token of the sub-account
# (Settings > Private Integrations; contacts and opportunities read/write, locations read). The sub-account
# (location) id, pipeline and stage names are in the business profile.
GHL_TOKEN=
