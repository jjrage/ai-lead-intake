{
  "id": "LeadAsstSend0001",
  "name": "Assistant · Send message",
  "description": "Sends one stored outbound message on its channel.",
  "nodes": [
    {
      "parameters": {
        "content": "## Send one message\nSends a stored outbound message (from the AI or a person) on its channel and records the result. Website chat messages are only marked sent: the page fetches them. Email (and replies to the website form) works in draft mode: the reply becomes a Gmail draft in the lead's thread, and Slack tells the team to review and send it. A failed send is recorded and reported in Slack.\nAnswers the lead can tap (`quick_replies` from Reply turn, \"Other\" last) go as buttons: a reply keyboard in Telegram, reply buttons in WhatsApp (three at most: the first two options and \"Other\"), quick replies in Messenger and Instagram.",
        "height": 220,
        "width": 1000,
        "color": 6
      },
      "id": "3b3a5e8c-464c-4492-a715-fe38a4d21fa0",
      "name": "Note: send",
