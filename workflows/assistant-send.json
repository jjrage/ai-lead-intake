      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT m.id, m.text, m.status, m.channel, m.conversation_id, m.template, i.external_id, i.address,\n       coalesce(i.last_inbound_at > now() - interval '24 hours', false) AS in_window\nFROM assistant.messages m\nJOIN assistant.conversations v ON v.id = m.conversation_id\nJOIN assistant.contacts ct ON ct.id = v.contact_id\nLEFT JOIN assistant.identities i ON i.profile = ct.profile AND i.channel = m.channel AND i.external_id = m.identity_id\nWHERE m.id = $1::bigint",
        "options": {
          "queryReplacement": "={{ [ $json.message_id ] }}"
        }
      },
