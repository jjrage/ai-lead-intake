          "queryReplacement": "={{ [ $('Load message').first().json.id, String($json.message_id ?? $json.result?.message_id ?? $json.messages?.[0]?.id ?? ''), JSON.stringify(($('When called').first().json.quick_replies ?? [])) ] }}"
