{
  "id": "LeadAsstTeam0001",
  "name": "Assistant · Team replies (Slack)",
  "description": "Sends team replies from Slack threads to the lead and hands conversations back to the assistant.",
  "nodes": [
    {
      "parameters": {
        "content": "## The team in Slack\nEach conversation has a thread in #leads. A team member's reply in the thread goes to the lead on their channel and pauses the assistant for that conversation (`assistant.team_reply`). Replying `!ai`, or reacting ✅ to the thread's first message, hands it back. Messages starting with `//` stay internal. After a meeting the assistant asks whether it happened: 👍 or 👎 on that post sets the lead's stage (Showed / No-show) and, for a no-show, has the assistant offer another time. Slack signs every event; the trigger checks the signature.",
        "height": 220,
        "width": 1100,
        "color": 6
      },
      "id": "15bf9a67-502a-4aaf-affe-6a803e11dfb1",
      "name": "Note: team",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        -300
      ]
    },
