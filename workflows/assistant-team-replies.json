    {
      "parameters": {
        "jsCode": "// Keeps only what the team does in a conversation's thread: a reply for the lead, a hand-back to\n// the assistant (\"!ai\" in the thread, or ✅ on the thread's first message), or whether a meeting\n// happened (👍 or 👎 on the assistant's question after it). Messages starting with \"//\" are the\n// team talking among themselves and are not sent.\nconst e = $input.first().json;\nconst ignore = [{ json: { kind: 'ignore' } }];\nif (e.type === 'reaction_added') {\n  if (e.item?.type !== 'message') return ignore;\n  const reaction = String(e.reaction ?? '').split('::')[0];  // \"+1::skin-tone-3\" is 👍 too\n  if (reaction === 'white_check_mark') return [{ json: { kind: 'handback', thread: e.item.ts, user: e.user } }];\n  if (['+1', 'thumbsup', '-1', 'thumbsdown'].includes(reaction)) {\n    return [{ json: { kind: 'outcome', post: e.item.ts, outcome: ['+1', 'thumbsup'].includes(reaction) ? 'done' : 'no_show', user: e.user } }];\n  }\n  return ignore;\n}\nif (e.type !== 'message' || e.bot_id || e.subtype || !e.thread_ts || e.thread_ts === e.ts) return ignore;\n// Slack markup to plain text: mentions dropped, links as their label, entities decoded.\nconst text = String(e.text ?? '')\n  .replace(/<@[A-Z0-9]+>/g, '')\n  .replace(/<(https?:[^|>]+)\\|([^>]+)>/g, '$2 ($1)')\n  .replace(/<(https?:[^>]+)>/g, '$1')\n  .replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&amp;/g, '&')\n  .trim();\nif (/^!ai\\b/i.test(text)) return [{ json: { kind: 'handback', thread: e.thread_ts, user: e.user } }];\nif (!text || text.startsWith('//')) return ignore;\nreturn [{ json: { kind: 'reply', thread: e.thread_ts, text, ts: e.ts, user: e.user } }];\n"
      },
