    {
      "parameters": {
        "jsCode": "// Update the contact the search found (only filling empty fields), or create one. With an email,\n// create goes through upsert-by-email, so a contact HubSpot hasn't indexed for search yet is not duplicated.\nconst crm = $('Prepare CRM records').first().json;\nconst found = $input.first().json.results?.[0] ?? null;\nconst base = 'https://api.hubapi.com/crm/v3/objects/contacts';\nconst props = crm.contactProperties;\nlet request;\nif (found) {\n  const current = found.properties ?? {};\n  const fill = Object.fromEntries(Object.entries(props).filter(([k]) => !current[k]));\n  // HubSpot rejects an empty PATCH; with nothing to add, just read the contact back.\n  request = Object.keys(fill).length\n    ? { method: 'PATCH', url: `${base}/${found.id}`, body: { properties: fill } }\n    : { method: 'POST', url: `${base}/batch/read`, body: { inputs: [{ id: found.id }], properties: ['email'] } };\n} else if (props.email) {\n  request = { method: 'POST', url: `${base}/batch/upsert`, body: { inputs: [{ idProperty: 'email', id: props.email, properties: { ...props, hs_lead_status: 'NEW', lifecyclestage: 'lead' } }] } };\n} else {\n  request = { method: 'POST', url: base, body: { properties: { ...props, hs_lead_status: 'NEW', lifecyclestage: 'lead' } } };\n}\nreturn [{ json: request }];\n"
      },
