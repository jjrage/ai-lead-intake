    {
      "parameters": {
        "jsCode": "function crmRecord(row, profile) {\n  const CHANNELS = { telegram: 'Telegram', whatsapp: 'WhatsApp', messenger: 'Messenger', instagram: 'Instagram', web_chat: 'Website chat', email: 'Email', web_form: 'Website form', lead_ads: 'Facebook lead form' };\n  const c = row.contact;\n  const facts = c.facts ?? {};\n  const [first, ...rest] = String(c.name ?? '').trim().split(/\\s+/).filter(Boolean);\n  // \"$650k\", \"$400k-$500k\", \"1.2M\": the top of the stated range.\n  const amounts = String(facts.budget ?? '').toLowerCase().replace(/,/g, '').match(/\\d+(?:\\.\\d+)?\\s*[km]?/g) ?? [];\n  const values = amounts.map((a) => parseFloat(a) * (a.endsWith('m') ? 1e6 : a.endsWith('k') ? 1e3 : 1)).filter((n) => n >= 1000);\n  const intent = profile.intents[facts.intent]?.label ?? 'New inquiry';\n  // A seller's deal is about the home they sell; anyone else's, about where they want to be.\n  const place = facts.intent === 'sell' ? (facts.property_area ?? facts.area) : (facts.area ?? facts.property_area);\n  const time = (t) => new Intl.DateTimeFormat('en-US', { timeZone: profile.business.timezone, month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }).format(new Date(t));\n  const who = { lead: c.name || 'Lead', ai: profile.assistant.name, human: 'Team' };\n  return {\n    first_name: first ?? null,\n    last_name: rest.join(' ') || null,\n    intent,\n    deal_name: `${c.name || 'Lead'} – ${intent}${place ? `, ${place}` : ''}`.slice(0, 200),\n    amount: values.length && facts.intent !== 'rent' ? Math.max(...values) : null,\n    details: Object.entries(facts).filter(([k]) => k !== 'intent').map(([k, v]) => [k.replace(/_/g, ' '), String(v)]),\n    channels: [...new Set(row.messages.map((m) => CHANNELS[m.channel] ?? m.channel))],\n    transcript: row.messages.map((m) => ({ time: time(m.sent_at), who: who[m.author] ?? m.author, text: m.text })),\n  };\n}\n\n// Contact, deal and transcript note for HubSpot, from what the assistant has learned (crmRecord()\n// in core/assistant.mjs, shared with the GoHighLevel adapter).\nconst profile = JSON.parse($('Read profile text').first().json.text);\nconst row = $('Load lead').first().json;\nconst c = row.contact;\nconst r = crmRecord(row, profile);\nconst esc = (s) => String(s ?? '').replace(/[&<>]/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[ch]);\n\nconst contactProperties = {};\nfor (const [k, v] of Object.entries({ firstname: r.first_name, lastname: r.last_name, email: c.email, phone: c.phone })) if (v) contactProperties[k] = v;\nconst filterGroups = [];\nif (c.email) filterGroups.push({ filters: [{ propertyName: 'email', operator: 'EQ', value: c.email }] });\nif (c.phone) filterGroups.push({ filters: [{ propertyName: 'phone', operator: 'EQ', value: c.phone }] });\n\nconst stages = profile.crm.hubspot.pipeline_stages;\nconst dealProperties = { dealname: r.deal_name, pipeline: 'default', dealstage: stages[c.stage] ?? stages.new };\nif (r.amount) dealProperties.amount = String(r.amount);\n\nconst noteBody = [\n  `<p><b>${c.is_hot ? '🔥 Hot lead. ' : ''}${esc(row.summary ?? 'Conversation with the assistant.')}</b></p>`,\n  `<ul><li>Wants: ${esc(r.intent)}</li>${r.details.map(([k, v]) => `<li>${esc(k)}: ${esc(v)}</li>`).join('')}<li>Stage: ${esc(c.stage)}</li>`,\n  c.opted_out_at ? '<li>Asked not to be contacted</li>' : '',\n  row.conversation.mode === 'human' ? `<li>Handled by the team: ${esc(row.conversation.handoff_reason ?? '')}</li>` : '',\n  `</ul><p><b>Conversation</b> (${esc(r.channels.join(', '))})<br>`,\n  r.transcript.map((m) => `[${m.time}] <b>${esc(m.who)}:</b> ${esc(m.text)}`).join('<br>'),\n  `</p><p><i>AI Lead Assistant · conversation #${row.conversation.id} · AI cost $${Number(row.ai_cost_usd).toFixed(4)}</i></p>`,\n].join('');\n\nreturn [{ json: { contact_id: c.id, crm_contact_id: c.crm_contact_id, crm_deal_id: c.crm_deal_id, crm_note_id: row.conversation.crm_note_id, search: { filterGroups, properties: ['email', 'phone', 'firstname', 'lastname'], limit: 1 }, contactProperties, dealProperties, noteBody } }];\n"
      },
