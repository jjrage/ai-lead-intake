      "parameters": {
        "operation": "executeQuery",
        "query": "-- The person, their conversation and its transcript (every channel), for the CRM record.\nWITH conv AS (SELECT * FROM assistant.conversations WHERE id = $1::bigint),\nct AS (SELECT c.* FROM assistant.contacts c JOIN conv ON c.id = conv.contact_id)\nSELECT (SELECT row_to_json(ct) FROM ct) AS contact,\n       (SELECT row_to_json(conv) FROM conv) AS conversation,\n       (SELECT coalesce(json_agg(t ORDER BY t.sent_at, t.id), '[]') FROM (\n          SELECT m.id, m.author, m.channel, m.text, m.sent_at\n          FROM assistant.messages m JOIN assistant.conversations v ON v.id = m.conversation_id\n          WHERE v.contact_id = (SELECT id FROM ct) AND m.status IN ('received', 'sent')\n          ORDER BY m.sent_at DESC, m.id DESC LIMIT 60) t) AS messages,\n       (SELECT result->>'summary' FROM assistant.ai_calls WHERE conversation_id = $1::bigint AND ok ORDER BY id DESC LIMIT 1) AS summary,\n       (SELECT coalesce(sum(cost_usd), 0) FROM assistant.ai_calls WHERE conversation_id = $1::bigint) AS ai_cost_usd",
        "options": {
          "queryReplacement": "={{ [ $json.conversation_id ] }}"
        }
      },
