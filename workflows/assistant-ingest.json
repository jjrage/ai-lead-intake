{
  "id": "LeadAsstIngest01",
  "name": "Assistant · Ingest message",
  "description": "Stores one inbound message (any channel) and starts a reply turn.",
  "nodes": [
    {
      "parameters": {
        "content": "## Ingest one message\nEvery channel calls this with the same message format. `assistant.ingest()` stores it once (a redelivered webhook is a duplicate), finds the person by channel id, phone or email, and opens their conversation. Then **Reply turn** starts in the background: it waits a few seconds so a burst of short messages gets one answer.\n**Demo only:** `/reset` on any channel forgets the sender (`assistant.forget_contact()`, CRM untouched) and starts over, so people trying the demo can run it again. Remove **Start over?** for a real business.",
        "height": 220,
        "width": 1700,
        "color": 6
      },
      "id": "a89d176c-1c30-4c45-a33c-53723feb7d13",
      "name": "Note: ingest",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        -440
      ]
    },
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "17d1f1ba-253a-46b2-ac58-6096af8c43ce",
      "name": "When called by a channel",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "65d85c3e-0adc-3dbe-5f1c-4c9517df9898",
              "leftValue": "={{ String($json.text ?? '').trim().toLowerCase() === '/reset' }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "c73d6b16-adaa-456f-a5b2-bbf87c6d1dd7",
      "name": "Start over?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT count(assistant.forget_contact(contact_id)) AS forgotten FROM assistant.identities WHERE profile = $1 AND channel = $2 AND external_id = $3",
        "options": {
          "queryReplacement": "={{ [ $json.profile, $json.channel, $json.external_user_id ] }}"
        }
      },
      "id": "0d638829-eea4-47da-a630-56c8941317f1",
      "name": "Forget the sender",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        440,
        -160
      ],
      "credentials": {
        "postgres": {
          "id": "liCredPostgres01",
          "name": "Lead Intake Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// The sender is forgotten; their \"/reset\" opens a new conversation, like a first visit.\nreturn $('When called by a channel').all().map((item) => ({ json: { ...item.json, text: '(opened the chat)' } }));\n"
      },
      "id": "f20f34b5-7dc3-47e0-abd1-9448233f3b1b",
      "name": "Start fresh",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
