        "query": "SELECT count(*) FILTER (WHERE identity_id = $1) AS email_count, count(*) AS all_count\nFROM assistant.messages\nWHERE channel = 'web_form' AND direction = 'in' AND created_at > now() - interval '24 hours'",
        "options": {
