    {
      "parameters": {
        "jsCode": "function normalizePhone(raw) {\n  const digits = String(raw ?? '').replace(/\\D/g, '');\n  if (digits.length < 10) return null;\n  return digits.length === 10 ? `+1${digits}` : `+${digits}`;\n}\n\nfunction normalizeEmail(raw) {\n  const s = String(raw ?? '').trim().toLowerCase();\n  return /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(s) ? s : null;\n}\n\n// The website's contact form becomes the common inbound message. The person typed their name, email\n// and phone, so Ingest stores them, and finds the person again when they answer the reply by email.\n// A filled-in hidden \"website\" field means a bot.\nconst profile = $('Config').first().json.profile;\nconst b = $('Form submission').first().json.body ?? {};\nconst field = (v, max) => String(v ?? '').trim().slice(0, max);\nconst name = field(b.name, 100);\nconst email = normalizeEmail(b.email);\nconst phone = normalizePhone(b.phone);\nconst message = field(b.message, 2000);\nconst id = field(b.form_id, 64);\nif (field(b.website, 200) || !email || !message || !/^[A-Za-z0-9-]{8,64}$/.test(id)) return [{ json: { valid: false } }];\nconst answers = [['name', name], ['email', email], ['phone', phone], ['message', message]].filter(([, v]) => v);\nreturn [{ json: {\n  valid: true,\n  profile,\n  channel: 'web_form',\n  external_user_id: email,\n  external_message_id: id,\n  sent_at: new Date().toISOString(),\n  text: `(sent the contact form on the website: ${answers.map(([k, v]) => `${k}: ${v}`).join('; ')})`,\n  attachments: [],\n  sender: { name: name || null, display_name: name || null, username: null, phone, email },\n  address: { email },\n} }];\n"
      },
      "id": "6ed5fb2d-a704-4339-a023-c4478d03f3fd",
