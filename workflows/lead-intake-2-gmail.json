{
  "id": "LeadIntakeGmail1",
  "name": "Lead Intake · 2 Gmail",
  "description": "Polls the agency inbox and hands each new email to processing.",
  "nodes": [
    {
      "parameters": {
        "content": "## Agency inbox (Gmail)\nChecks the inbox every minute. Each new email is processed by **3 Process lead** one at a time, then tagged with the Gmail label **Lead Intake** (created on first use). Repeats are stopped by the lead log in Postgres, keyed by the Gmail message id.",
        "height": 180,
        "width": 900,
        "color": 6
      },
      "id": "ecad96be-e700-45cb-a315-5b448d105ddd",
      "name": "Note: gmail",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        -220
      ]
    },
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "simple": false,
        "filters": {
          "q": "in:inbox -from:me",
          "readStatus": "both"
        },
        "options": {}
      },
      "id": "d1319c65-4aa3-468c-a8d8-10c0429f2bc0",
      "name": "New email",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "liCredGmail00001",
          "name": "Gmail (agency inbox)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// One inbound email becomes the lead record the processing workflow expects. Keyed by the Gmail\n// message id, so the same email is never processed twice.\nreturn $input.all().map((item) => {\n  const m = item.json;\n  const from = m.from?.value?.[0] ?? {};\n  const address = String(from.address ?? '').toLowerCase();\n  const text = String(m.text ?? '').trim() || String(m.html ?? '').replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim();\n  const received = m.date ? new Date(m.date).toISOString() : new Date().toISOString();\n  const input = { channel: 'email', received_at: received, from: from.name ? `${from.name} <${address}>` : address, subject: m.subject ?? '', body: text };\n  return { json: { source: 'email', raw_key: `gmail|${m.id}`, received_at: received, input, reply_to: address, thread_id: m.threadId, message_id: m.id } };\n});\n"
      },
      "id": "7816e7db-7659-486a-a5a2-5a011f4de4ab",
      "name": "Normalize email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
